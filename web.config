<?xml version="1.0" encoding="UTF-8"?>
<!--
  Drop this web.config in the same IIS folder as geo-pardy.html and
  geo-pardy-questions.csv (e.g. C:\inetpub\wwwroot\geopardy\).

  It does two things:
    1. Makes sure IIS serves .csv files (so the game can fetch the questions).
    2. Loads geo-pardy.html when someone browses to the folder URL.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- remove first in case already registered, to avoid a duplicate-entry error -->
      <remove fileExtension=".csv" />
      <mimeMap fileExtension=".csv" mimeType="text/csv" />
      <remove fileExtension=".wav" />
      <mimeMap fileExtension=".wav" mimeType="audio/wav" />
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
    </staticContent>
    <defaultDocument>
      <files>
        <add value="geo-pardy.html" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
